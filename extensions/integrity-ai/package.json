{
  "name": "integrity-ai",
  "displayName": "Integrity AI",
  "description": "Local-first AI assistant for Integrity IDE — chat, completions, codebase search, and agent mode",
  "version": "0.1.0",
  "publisher": "integrity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatProvider",
    "findTextInFiles",
    "textSearchProvider",
    "languageModelSystem",
    "languageModelThinkingPart"
  ],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "title": "Integrity AI",
      "properties": {
        "integrity.ai.defaultProvider": {
          "type": "string",
          "enum": ["ollama", "openai-compat", "anthropic"],
          "default": "ollama",
          "description": "Default model provider for chat and completions"
        },
        "integrity.ai.cloudFallbackEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow cloud BYOK providers when local models are unavailable"
        },
        "integrity.ai.ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama server base URL"
        },
        "integrity.ai.ollama.chatModel": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "Ollama model for chat and agent"
        },
        "integrity.ai.ollama.completionModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Ollama model for inline completions"
        },
        "integrity.ai.ollama.embeddingModel": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Ollama model for codebase embeddings"
        },
        "integrity.ai.openaiCompat.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL"
        },
        "integrity.ai.openaiCompat.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI-compatible provider"
        },
        "integrity.ai.openaiCompat.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model name for OpenAI-compatible provider"
        },
        "integrity.ai.anthropic.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key (BYOK)"
        },
        "integrity.ai.anthropic.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "Anthropic model name"
        },
        "integrity.ai.inlineCompletions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ghost-text inline completions"
        },
        "integrity.ai.inlineCompletions.advanced": {
          "type": "object",
          "default": {},
          "description": "Advanced inline completion settings"
        },
        "integrity.ai.agent.requireTerminalApproval": {
          "type": "boolean",
          "default": true,
          "description": "Require user approval before running terminal commands in agent mode"
        },
        "integrity.ai.agent.requireEditApproval": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation before applying agent file edits"
        },
        "integrity.ai.agent.maxSteps": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum tool-calling steps per agent turn"
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "integrity",
        "displayName": "Integrity AI",
        "managementCommand": "integrity.ai.testConnection"
      }
    ],
    "chatParticipants": [
      {
        "id": "integrity.integrity-ai",
        "name": "integrity",
        "fullName": "Integrity AI",
        "description": "Local-first coding assistant with Ask, Edit, and Agent modes",
        "isDefault": true,
        "locations": ["panel"],
        "modes": ["ask", "edit", "agent"]
      }
    ],
    "languageModelTools": [
      {
        "name": "integrity_read_file",
        "toolReferenceName": "readFile",
        "displayName": "Read File",
        "modelDescription": "Read a workspace-relative file. Returns file contents (truncated).",
        "icon": "$(file)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            }
          },
          "required": ["path"]
        },
        "tags": ["integrity"]
      },
      {
        "name": "integrity_list_dir",
        "toolReferenceName": "listDir",
        "displayName": "List Directory",
        "modelDescription": "List files and directories at a workspace-relative path.",
        "icon": "$(folder)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative directory path (default '.')"
            }
          }
        },
        "tags": ["integrity"]
      },
      {
        "name": "integrity_create_file",
        "toolReferenceName": "createFile",
        "displayName": "Create File",
        "modelDescription": "Create a new file with the given content. Fails if the file exists unless overwrite is true.",
        "icon": "$(new-file)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "content": {
              "type": "string",
              "description": "File contents"
            },
            "overwrite": {
              "type": "boolean",
              "description": "Overwrite if the file already exists"
            }
          },
          "required": ["path", "content"]
        },
        "tags": ["integrity"]
      },
      {
        "name": "integrity_replace_string",
        "toolReferenceName": "replaceString",
        "displayName": "Replace String In File",
        "modelDescription": "Replace a unique oldText with newText in a file. Fails if oldText is missing or appears more than once.",
        "icon": "$(replace)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path"
            },
            "oldText": {
              "type": "string",
              "description": "Exact text to find (must be unique)"
            },
            "newText": {
              "type": "string",
              "description": "Replacement text"
            }
          },
          "required": ["path", "oldText", "newText"]
        },
        "tags": ["integrity"]
      },
      {
        "name": "integrity_grep_search",
        "toolReferenceName": "grepSearch",
        "displayName": "Grep Search",
        "modelDescription": "Search workspace file contents with a regular expression pattern.",
        "icon": "$(search)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Regular expression pattern"
            },
            "glob": {
              "type": "string",
              "description": "Optional glob to limit files (e.g. **/*.ts)"
            },
            "maxResults": {
              "type": "number",
              "description": "Maximum matches to return"
            }
          },
          "required": ["pattern"]
        },
        "tags": ["integrity"]
      },
      {
        "name": "integrity_file_search",
        "toolReferenceName": "fileSearch",
        "displayName": "File Search",
        "modelDescription": "Find files by glob pattern.",
        "icon": "$(files)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "glob": {
              "type": "string",
              "description": "Glob pattern (e.g. **/package.json)"
            },
            "maxResults": {
              "type": "number"
            }
          },
          "required": ["glob"]
        },
        "tags": ["integrity"]
      },
      {
        "name": "integrity_codebase_search",
        "toolReferenceName": "codebase",
        "displayName": "Codebase Search",
        "modelDescription": "Semantic search over the local Integrity codebase index.",
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language query"
            }
          },
          "required": ["query"]
        },
        "tags": ["integrity", "codesearch"]
      },
      {
        "name": "integrity_get_errors",
        "toolReferenceName": "problems",
        "displayName": "Get Errors",
        "modelDescription": "List workspace diagnostics (errors and warnings), optionally filtered by path.",
        "icon": "$(warning)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Optional workspace-relative path filter"
            }
          }
        },
        "tags": ["integrity"]
      }
    ],
    "commands": [
      {
        "command": "integrity.ai.openChat",
        "title": "Open Integrity Chat",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.openStatus",
        "title": "Open Integrity Status",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.testConnection",
        "title": "Test Model Connection",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.setupModels",
        "title": "Setup Recommended Models (Ollama)",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.reindexCodebase",
        "title": "Reindex Codebase",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.toggleAgentMode",
        "title": "Toggle Agent Mode (legacy webview)",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.applyCodeBlock",
        "title": "Apply Code Block",
        "category": "Integrity"
      },
      {
        "command": "integrity.ai.insertCodeBlock",
        "title": "Insert Code Block at Cursor",
        "category": "Integrity"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "integrity-ai",
          "title": "Integrity AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "integrity-ai": [
        {
          "type": "webview",
          "id": "integrity.ai.chatView",
          "name": "Status"
        }
      ]
    },
    "keybindings": [
      {
        "command": "integrity.ai.openChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:integrity-ai",
    "watch": "gulp watch-extension:integrity-ai",
    "test": "npx --yes tsx --test src/**/test/*.test.ts src/**/test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Riley94/integrity.git"
  }
}
